# Development Environment Configuration
# Copy this file to dev.env and update with your values
# This file should NOT be committed to version control

# ==============================================
# API Configuration
# ==============================================
COOLIFY_API_KEY=sk_dev_xxxxxxxxxxxxxxxxxxxx
COOLIFY_API_URL=http://localhost:3000
COOLIFY_VERBOSE=true
COOLIFY_TIMEOUT=30

# ==============================================
# Caching Configuration
# ==============================================
COOLIFY_CACHE_ENABLED=true
COOLIFY_CACHE_TTL=60

# ==============================================
# Retry Configuration
# ==============================================
COOLIFY_RETRY_ATTEMPTS=2
COOLIFY_RETRY_DELAY_MS=500

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=Debug
LOG_FILE=logs/coolify-cli.log
ENABLE_CONSOLE_OUTPUT=true

# ==============================================
# Development-specific Settings
# ==============================================
ENVIRONMENT=development
DEBUG_MODE=true
ALLOW_INSECURE_SSL=false

# ==============================================
# Application IDs
# ==============================================
# List of development application IDs (comma-separated)
DEV_APP_IDS=1,2,3

# ==============================================
# Database Configuration
# ==============================================
# Development database IDs
DEV_DB_IDS=1,2

# ==============================================
# Deployment Configuration
# ==============================================
# Deployment strategy: blue-green, canary, rolling
DEPLOYMENT_STRATEGY=blue-green

# ==============================================
# Notification Configuration (Optional)
# ==============================================
# Webhook URL for deployment notifications
WEBHOOK_URL=http://localhost:3001/webhooks/deployments

# ==============================================
# Feature Flags
# ==============================================
ENABLE_BATCH_DEPLOYMENT=true
ENABLE_HEALTH_CHECKS=true
ENABLE_AUTO_ROLLBACK=true
