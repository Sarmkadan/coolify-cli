# Production Environment Configuration
# Copy this file to prod.env and update with your values
# CRITICAL: This file should NOT be committed to version control
# Use secrets management system or encrypted files instead

# ==============================================
# API Configuration
# ==============================================
# Use secrets manager for API key in production
# Example: COOLIFY_API_KEY=$(aws secretsmanager get-secret-value --secret-id coolify-api-key)
COOLIFY_API_KEY=sk_prod_xxxxxxxxxxxxxxxxxxxx
COOLIFY_API_URL=https://coolify.example.com
COOLIFY_VERBOSE=false
COOLIFY_TIMEOUT=120

# ==============================================
# Caching Configuration
# ==============================================
COOLIFY_CACHE_ENABLED=true
COOLIFY_CACHE_TTL=600

# ==============================================
# Retry Configuration
# ==============================================
COOLIFY_RETRY_ATTEMPTS=5
COOLIFY_RETRY_DELAY_MS=2000

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=Error
LOG_FILE=/var/log/coolify-cli/coolify-cli.log
ENABLE_CONSOLE_OUTPUT=false

# Structured logging for production
LOG_FORMAT=json
SYSLOG_ENABLED=true
SYSLOG_FACILITY=local0

# ==============================================
# Production-specific Settings
# ==============================================
ENVIRONMENT=production
DEBUG_MODE=false
ALLOW_INSECURE_SSL=false

# TLS/SSL Configuration
TLS_MIN_VERSION=TLS1.3
VERIFY_SSL_CERTIFICATE=true

# ==============================================
# Application IDs
# ==============================================
# List of production application IDs (comma-separated)
PROD_APP_IDS=7,8,9

# ==============================================
# Database Configuration
# ==============================================
# Production database IDs
PROD_DB_IDS=5,6

# ==============================================
# Deployment Configuration
# ==============================================
# Deployment strategy: blue-green (recommended for prod)
DEPLOYMENT_STRATEGY=blue-green

# Blue-Green deployment settings
BG_HEALTH_CHECK_TIMEOUT_SECONDS=300
BG_TRAFFIC_SWITCH_DELAY_SECONDS=30
BG_POST_DEPLOYMENT_MONITORING_MINUTES=10

# ==============================================
# Notification Configuration
# ==============================================
# Multiple notification channels for production

# Slack notifications (critical only)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFY_ON_DEPLOYMENT=true
SLACK_NOTIFY_ON_FAILURE=true
SLACK_NOTIFY_ON_ROLLBACK=true

# Email notifications
EMAIL_ON_FAILURE=ops-team@example.com
EMAIL_ON_SUCCESS=devops@example.com
EMAIL_ON_ROLLBACK=ops-team@example.com

# PagerDuty integration (for critical failures)
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key
PAGERDUTY_ENABLED_FOR_FAILURES=true

# ==============================================
# Security Configuration
# ==============================================
# Rate limiting for API calls
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Request signing (if supported)
SIGN_REQUESTS=true
SIGNING_KEY=sk_sign_xxxxxx

# IP whitelist (if using API gateway)
ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16

# ==============================================
# Feature Flags
# ==============================================
ENABLE_BATCH_DEPLOYMENT=true
ENABLE_HEALTH_CHECKS=true
ENABLE_AUTO_ROLLBACK=true
ENABLE_METRICS_COLLECTION=true
ENABLE_AUDIT_LOGGING=true

# ==============================================
# Performance Settings
# ==============================================
MAX_CONCURRENT_DEPLOYMENTS=1
DEPLOYMENT_TIMEOUT_MINUTES=30
HEALTH_CHECK_INTERVAL_SECONDS=15

# Connection pooling
HTTP_CONNECTION_POOL_SIZE=10
HTTP_CONNECTION_TIMEOUT_SECONDS=30

# ==============================================
# Backup Configuration
# ==============================================
BACKUP_BEFORE_DEPLOYMENT=true
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups/coolify-cli

# ==============================================
# Monitoring & Observability
# ==============================================
# Prometheus metrics
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=9090

# APM/Tracing (if using)
APM_ENABLED=false
APM_SERVICE_NAME=coolify-cli
APM_ENVIRONMENT=production

# ==============================================
# Disaster Recovery
# ==============================================
# Keep a maintenance window during deployments
MAINTENANCE_WINDOW_START_UTC=02:00
MAINTENANCE_WINDOW_END_UTC=04:00

# Automatic rollback on critical errors
AUTO_ROLLBACK_ON_ERROR=true
CRITICAL_ERROR_PATTERNS=("OOM", "Panic", "Fatal")
