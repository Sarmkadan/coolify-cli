# Staging Environment Configuration
# Copy this file to staging.env and update with your values
# This file should NOT be committed to version control

# ==============================================
# API Configuration
# ==============================================
COOLIFY_API_KEY=sk_staging_xxxxxxxxxxxxxxxxxxxx
COOLIFY_API_URL=https://coolify-staging.example.com
COOLIFY_VERBOSE=false
COOLIFY_TIMEOUT=60

# ==============================================
# Caching Configuration
# ==============================================
COOLIFY_CACHE_ENABLED=true
COOLIFY_CACHE_TTL=300

# ==============================================
# Retry Configuration
# ==============================================
COOLIFY_RETRY_ATTEMPTS=3
COOLIFY_RETRY_DELAY_MS=1000

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=Information
LOG_FILE=logs/coolify-cli-staging.log
ENABLE_CONSOLE_OUTPUT=true

# ==============================================
# Staging-specific Settings
# ==============================================
ENVIRONMENT=staging
DEBUG_MODE=false
ALLOW_INSECURE_SSL=false

# ==============================================
# Application IDs
# ==============================================
# List of staging application IDs (comma-separated)
STAGING_APP_IDS=4,5,6

# ==============================================
# Database Configuration
# ==============================================
# Staging database IDs
STAGING_DB_IDS=3,4

# ==============================================
# Deployment Configuration
# ==============================================
# Deployment strategy: blue-green, canary, rolling
DEPLOYMENT_STRATEGY=canary

# Canary deployment settings
CANARY_INITIAL_PERCENTAGE=10
CANARY_INCREMENT_PERCENTAGE=25
CANARY_INTERVAL_MINUTES=5

# ==============================================
# Notification Configuration
# ==============================================
# Slack webhook for deployment notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFY_ON_DEPLOYMENT=true
SLACK_NOTIFY_ON_FAILURE=true

# Email notifications
EMAIL_ON_FAILURE=devops-staging@example.com
EMAIL_ON_SUCCESS=devops-staging@example.com

# ==============================================
# Feature Flags
# ==============================================
ENABLE_BATCH_DEPLOYMENT=true
ENABLE_HEALTH_CHECKS=true
ENABLE_AUTO_ROLLBACK=true
ENABLE_METRICS_COLLECTION=true

# ==============================================
# Performance Settings
# ==============================================
MAX_CONCURRENT_DEPLOYMENTS=2
DEPLOYMENT_TIMEOUT_MINUTES=15
HEALTH_CHECK_INTERVAL_SECONDS=30
